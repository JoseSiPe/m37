# Ruta absoluta al workspace operativo (DEBE estar fuera del repo m37-core para uso real)
M37_VAULT=C:/Users/tu_usuario/Documents/m37_workspace

# Modelo Orquestador por defecto (alias de Modelos.yaml, sobrescribible con --orchestrator)
M37_ORCHESTRATOR=gemini_flash

# Confirmación de términos de privacidad de API:
# - demo_only: permite L1/L2 con llaves gratuitas; BLOQUEA encargos L3/L4 de clientes reales
# - paid_billing: declara que las APIs activas tienen facturación vinculada (sin entrenamiento sobre prompts)
M37_DATA_PRIVACY_ACK=demo_only

# Credenciales de proveedores (activa solo los que tengas; M37 auto-detecta el pool disponible)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Sandbox de cómputo (run_sandbox_script / run_verification_cmd) ---
# auto (por defecto): usa el contenedor si docker/podman responde y existe la imagen; si no, `process`.
# container: exige contenedor (sin red, solo el encargo montado). process: audit hook como alarma, NO aísla clientes.
M37_SANDBOX_BACKEND=auto
# Imagen construida con: docker build -t m37-sandbox:latest extensions/sandbox
M37_SANDBOX_IMAGE=m37-sandbox:latest
# Con backend `process` el cómputo se bloquea si el workspace mezcla encargos de más de un cliente.
# Ponlo en 1 solo si asumes ese riesgo de forma explícita.
M37_ALLOW_SHARED_WORKSPACE_COMPUTE=
# Con backend `process`, permite ctypes para poder importar polars/duckdb dentro del script.
M37_SANDBOX_ALLOW_FFI=

# --- Modo harness (Antigravity / Claude Code / Codex CLI) ---
# Familia del modelo del harness que redacta los hallazgos (anthropic, google, openai...).
# `m37 qa` y m37_run_kernel_qa la usan para elegir un auditor de OTRA familia.
M37_HARNESS_FAMILY=
